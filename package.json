{
  "name": "steel-building-calc",
  "version": "1.0.0",
  "description": "Калькулятор стальных колонн промышленных зданий по СП 16.13330 / СП 20.13330",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-tsc.mjs --noEmit && node scripts/run-vite-build.mjs",
    "preview": "vite preview",
    "typecheck": "node scripts/run-tsc.mjs --noEmit",
    "lint": "node scripts/run-eslint.mjs .",
    "test": "node scripts/run-vitest.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "node scripts/run-eslint.mjs --fix"
    ]
  },
  "dependencies": {
    "hyperformula": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  }
}
